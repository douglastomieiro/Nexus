# ML Dashboard — copie para .env e preencha. NUNCA versione, sincronize ou compartilhe o .env real.

# Endereço em que o servidor escuta. Padrão: 127.0.0.1 (só este computador; a API não tem login).
# 0.0.0.0 = qualquer PC da sua rede abre (sem senha). Nunca publique a porta na internet (roteador, túnel, proxy).
HOST=

# ── Contas: repita o bloco com o número seguinte (LOJA3, LOJA4...) para mais contas ──
# Nome exibido no painel (padrão "Loja <n>").
NOME_LOJA1=
# Mercado Livre: caminho do arquivo JSON do token de LEITURA (relativo a esta pasta). Sem ele, a conta ML não aparece.
TOKENS_LOJA1=
# Shopee da mesma empresa (opcional): token de leitura + credenciais do app de parceiro. SEGREDO: SHOPEE_PARTNER_KEY_*.
SHOPEE_TOKENS_LOJA1=
SHOPEE_PARTNER_ID_LOJA1=
SHOPEE_PARTNER_KEY_LOJA1=

NOME_LOJA2=
TOKENS_LOJA2=
SHOPEE_TOKENS_LOJA2=
SHOPEE_PARTNER_ID_LOJA2=
SHOPEE_PARTNER_KEY_LOJA2=

# ── App do Mercado Livre usado para renovar os tokens de ESCRITA (tela Descontos). SEGREDO: ML_CLIENT_SECRET ──
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Observação: PORT (padrão 4000) e SEM_COLETA são lidos só do ambiente do processo, não deste arquivo.
